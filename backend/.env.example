# ─────────────────────────────────────────────────────────────────────────────
# LinkShort Backend – Environment Variables
# Copy to .env for local dev. Set these in Render dashboard for production.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
#
# Use the TRANSACTION POOLER URL from:
#   Supabase Dashboard → Project → Settings → Database → Connection Pooling
#
# Format:
#   jdbc:postgresql://<pooler-host>:6543/postgres?pgbouncer=true&sslmode=require
#
# Your project ref: rjfrlugtnsannjundxxl  (ap-south-1 region)
#
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DB_USERNAME=postgres.rjfrlugtnsannjundxxl
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure key: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_256_bit_secret_here
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

# ── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://linkshort-backend.onrender.com

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://linkshort-frontend.onrender.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=10
RATE_LIMIT_LINKS=60
RATE_LIMIT_WINDOW=60
