# ─────────────────────────────────────────────────────────────────────────────
# LinkShort Backend – Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/linkshort?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=linkshort
DB_PASSWORD=your_strong_db_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_256_bit_secret_here
JWT_ACCESS_EXPIRY=900000       # 15 minutes in ms
JWT_REFRESH_EXPIRY=604800000   # 7 days in ms

# ── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
PORT=8080

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=10
RATE_LIMIT_LINKS=60
RATE_LIMIT_WINDOW=60
